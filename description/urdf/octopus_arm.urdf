  <link name="world"/>

  

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="Plane_012"/>
    <origin xyz="0.0 0 6.0" rpy="0 1.7708 0"/>
  </joint>

  <!-- Plane_012_joint commented out in original — left as-is -->

  <joint name="Plane_011_joint" type="revolute">
    <origin xyz="0 0 0.666345" rpy="0 0 0" />
    <parent link="Plane_012" />
    <child link="Plane_011" />
    <axis xyz="1 0 0" />
    <limit effort="10" velocity="1" lower="-3.141593" upper="3.141593" />
    <!-- Increased damping for stable soft-arm simulation; friction raised to prevent slip -->
    <dynamics damping="10.0" friction="0.5"/>
  </joint>

  <joint name="Plane_010_joint" type="revolute">
    <origin xyz="0 0 0.666340" rpy="0 0 0" />
    <parent link="Plane_011" />
    <child link="Plane_010" />
    <axis xyz="0 1 0" />
    <limit effort="10" velocity="1" lower="-3.141593" upper="3.141593" />
    <dynamics damping="10.0" friction="0.5"/>
  </joint>

