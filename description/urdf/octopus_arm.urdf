  </joint>

  <joint name="Plane_002_joint" type="revolute">
    <origin xyz="0.693168 -0.198533 0.029878" rpy="0 0 -1.047411" />
    <parent link="Plane_001" />
    <child link="Plane_002" />
    <axis xyz="1 0 0" />
    <limit effort="10" velocity="1" lower="-3.141593" upper="3.141593" />
    <!-- Fin/tentacle tip joints: slightly less damping for natural tip motion -->
    <dynamics damping="10.0" friction="0.5"/>
  </joint>

