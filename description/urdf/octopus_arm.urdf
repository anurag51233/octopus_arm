  <link name="camera_depth_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>
  
  <joint name="camera_depth_joint" type="fixed">
    <origin xyz="0.05 -0.6 0.05" rpy="0 -1.57 0"/>
    <parent link="Plane_001"/>
    <child link="camera_depth_frame"/>
  </joint>

  <link name="camera_rgb_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>

  <joint name="camera_rgb_joint" type="fixed">
    <origin xyz="0.05 -0.6 0.05" rpy="0 -1.57 0"/>
    <parent link="Plane_001"/>
    <child link="camera_rgb_frame"/>
  </joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="Plane_002_joint"><command_interface name="position" /><state_interface name="position" /><state_interface name="velocity" /></joint>
    <joint name="Plane_003_joint"><command_interface name="position" /><state_interface name="position" /><state_interface name="velocity" /></joint>
    <joint name="Plane_005_joint"><command_interface name="position" /><state_interface name="position" /><state_interface name="velocity" /></joint>
    <joint name="Plane_006_joint"><command_interface name="position" /><state_interface name="position" /><state_interface name="velocity" /></joint>
    <joint name="Plane_007_joint"><command_interface name="position" /><state_interface name="position" /><state_interface name="velocity" /></joint>
    <joint name="Plane_008_joint"><command_interface name="position" /><state_interface name="position" /><state_interface name="velocity" /></joint>
    <joint name="Plane_009_joint"><command_interface name="position" /><state_interface name="position" /><state_interface name="velocity" /></joint>
    <joint name="Plane_010_joint"><command_interface name="position" /><state_interface name="position" /><state_interface name="velocity" /></joint>
    <joint name="Plane_011_joint"><command_interface name="position" /><state_interface name="position" /><state_interface name="velocity" /></joint>
    <joint name="Plane_004_joint"><command_interface name="position" /><state_interface name="position" /><state_interface name="velocity" /></joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <robot_sim_type>gazebo_ros2_control/GazeboSystem</robot_sim_type>
      <parameters>install/octopus_arm_env/share/octopus_arm_env/config/controller_manager.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="camera_rgb_frame">
    <sensor name="rgb_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera name="head1">
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>512</width>
          <height>512</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>octopus</namespace>
          <remapping>image_raw:=image_raw</remapping>
          <remapping>camera_info:=camera_info</remapping>
        </ros>
        <camera_name>rgb_cam</camera_name>
        <frame_name>camera_rgb_frame</frame_name>
        <hack_baseline>0.07</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="camera_depth_frame">
    <sensor name="DepthCamN" type="depth">
      <always_on>true</always_on>
      <update_rate>30</update_rate> 
      <visualize>true</visualize>
      <pose>0.00268 0.001651 0.220087 0 0 0</pose>
      <camera name="head2">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>512</width>
          <height>512</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.001</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="depth_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>octopus</namespace>
        </ros>
        <camera_name>depth_cam</camera_name>
        <frame_name>camera_depth_frame</frame_name>
        <hack_baseline>0.07</hack_baseline>
        <min_depth>0.1</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

</robot>
