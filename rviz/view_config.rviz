Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Line Style: Lines
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Topic: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
    - Class: rviz_default_plugins/Image
      Topic: /octopus/depth_cam/image_raw
      Enabled: true
      Name: Camera View (RGB)
      Transport Hint: raw
    - Class: rviz_default_plugins/PointCloud2
      Topic: /octopus/depth_cam/points
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Enabled: true
      Name: Depth 3D View
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.3
      Show Axes: true
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.0
      Name: Current View
      Pitch: 0.5
      Yaw: 0.5
      Target Frame: world
Window Geometry:
  Displays:
    collapsed: false